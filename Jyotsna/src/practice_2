/**
 * controller_node.cpp  -  Lunabotics teleop controller (practice package)
 *
 * Controls follow the team's EDT controller layout:
 *   LT or RT (hold) ... Safety lock / deadman: robot only moves while held
 *   LB ................ Toggle TANK / ARCADE ("normal") drive
 *   Left stick ........ TANK: left side   | ARCADE: drive + turn
 *   Right stick ....... TANK: right side  | ARCADE: unused
 *   D-pad up / down ... Lift actuators up / down
 *   D-pad left / right  Tilt actuator up / down
 *   RB ................ Toggle vibrator ON / OFF
 *   B ................. STOP: cancel all movement (latched)
 *   View .............. Toggle SLOW / FAST speed
 *   A, X, Y, Menu ..... Reserved for autonomy (not implemented yet)
 *
 * Safety: deadman, latched stop, 0.5 s watchdog, crash protection,
 * stop on shutdown. Ramp rates and current limits on every motor.
 *
 * Read the guide before driving the real robot.
 */

#include "controller_pkg/SparkMax.hpp"

#include <algorithm>
#include <array>
#include <chrono>
#include <cmath>
#include <cstddef>
#include <cstdint>
#include <functional>
#include <memory>
#include <string>

#include <rclcpp/rclcpp.hpp>
#include <sensor_msgs/msg/joy.hpp>

using namespace std::chrono_literals;
using SteadyClock = std::chrono::steady_clock;
using JoyMsg = sensor_msgs::msg::Joy;

// =====================================================================
//  TUNING CONSTANTS - change these, rebuild, and test
// =====================================================================

// ---- Drive ----
constexpr double VELOCITY_MAX       = 2500.0; // motor RPM at full stick in FAST mode
constexpr double SLOW_MODE_SCALE    = 0.30;   // SLOW mode = 30% of VELOCITY_MAX
constexpr bool   START_IN_SLOW_MODE = true;   // safer to start slow
constexpr bool   START_IN_TANK_MODE = true;   // false = start in ARCADE ("normal") drive

// ---- Actuators (duty cycle: 0.0 = off, 1.0 = full power) ----
constexpr float LIFT_SPEED      = 0.5f;  // lift power while D-pad up/down is held
constexpr float TILT_SPEED      = 0.4f;  // tilt power while D-pad left/right is held
constexpr float VIBRATOR_OUTPUT = 1.0f;  // vibrator power when ON

// ---- Ramp rates (seconds to go from 0 to full output) ----
constexpr float DRIVE_RAMP_RATE    = 0.5f;   // drive motors (closed-loop velocity)
constexpr float ACTUATOR_RAMP_RATE = 0.25f;  // lift + tilt (open-loop duty cycle)

// ---- Current limits (amps) ----
constexpr uint16_t DRIVE_CURRENT_LIMIT    = 40;
constexpr uint16_t ACTUATOR_CURRENT_LIMIT = 20;  // check your actuator's datasheet

// ---- Safety ----
constexpr auto JOY_TIMEOUT      = 500ms;  // stop everything if no /joy message this long
constexpr auto HEARTBEAT_PERIOD = 20ms;   // how often heartbeat + watchdog run
constexpr bool REQUIRE_BOTH_TRIGGERS = false;  // false: hold LT OR RT. true: hold both.

// Saves the settings into each controller's memory at startup. Kept ON so a
// controller that resets mid-run (battery brownout) comes back with the
// right inversion and current limits. See the guide for the trade-off.
constexpr bool BURN_FLASH_ON_STARTUP = true;

// =====================================================================
//  HARDWARE
// =====================================================================

enum CAN_IDs
{
  LEFT_MOTOR  = 1,
  RIGHT_MOTOR = 2,
  LEFT_LIFT   = 3,
  RIGHT_LIFT  = 4,
  TILT        = 5,
  VIBRATOR    = 6,
};

// =====================================================================
//  CONTROLLER LAYOUT
//  Button/axis numbers depend on the controller AND the driver.
//  Pick the preset that matches what `ros2 topic echo /joy` shows,
//  or edit the numbers. -1 means "not used".
// =====================================================================

struct GamepadLayout
{
  // Buttons (index into msg.buttons)
  int a, b, x, y;
  int left_bumper, right_bumper;
  int view, menu;
  // Triggers: buttons, or axes that rest at +1.0 and read -1.0 fully pulled
  bool triggers_are_axes;
  int left_trigger, right_trigger;
  // D-pad: four buttons, or two axes (left = +1.0, up = +1.0)
  bool dpad_is_axes;
  int dpad_up, dpad_down, dpad_left, dpad_right;  // used when dpad_is_axes == false
  int dpad_x_axis, dpad_y_axis;                   // used when dpad_is_axes == true
  // Sticks (index into msg.axes; up = +1.0, left = +1.0)
  int left_x, left_y, right_y;
};

// ROS 2 `joy_node` with an Xbox controller on Linux (USB, xpad driver)
constexpr GamepadLayout JOY_NODE_XBOX = {
  0, 1, 2, 3,          // a, b, x, y
  4, 5,                // left_bumper, right_bumper
  6, 7,                // view, menu
  true, 2, 5,          // triggers are axes: LT = axis 2, RT = axis 5
  true,                // D-pad is axes
  -1, -1, -1, -1,      //   (no D-pad buttons)
  6, 7,                //   dpad_x_axis, dpad_y_axis
  0, 1, 4              // left_x, left_y, right_y
};

// The numbers in the team's original code ("standard gamepad" order)
constexpr GamepadLayout TEAM_ORIGINAL = {
  0, 1, 2, 3,          // a, b, x, y
  4, 5,                // left_bumper, right_bumper
  8, 9,                // view, menu
  false, 6, 7,         // triggers are buttons 6 and 7
  false,               // D-pad is buttons
  12, 13, 14, 15,      //   up, down, left, right
  -1, -1,              //   (no D-pad axes)
  0, 1, 3              // left_x, left_y, right_y
};

// >>> Pick the layout here <<<
constexpr GamepadLayout PAD = JOY_NODE_XBOX;

constexpr float TRIGGER_PRESSED_BELOW = -0.5f;  // trigger axis counts as held below this

// =====================================================================
//  CONTROLLER NODE
// =====================================================================

class ControllerNode : public rclcpp::Node
{
public:
  explicit ControllerNode(const std::string &can_interface)
  : Node("controller_node"),
    leftMotor(can_interface, LEFT_MOTOR),
    rightMotor(can_interface, RIGHT_MOTOR),
    leftLift(can_interface, LEFT_LIFT),
    rightLift(can_interface, RIGHT_LIFT),
    tilt(can_interface, TILT),
    vibrator(can_interface, VIBRATOR)
  {
    RCLCPP_INFO(get_logger(), "Initializing motor controllers...");
    configure_motors();
    stop_all();  // make sure nothing is moving before we start listening
    RCLCPP_INFO(get_logger(), "Motor controllers initialized");

    joy_sub_ = create_subscription<JoyMsg>(
      "/joy", 10, std::bind(&ControllerNode::joy_callback, this, std::placeholders::_1));

    // The safety timer sends heartbeats and runs the watchdog.
    // It shares a thread with the joystick callback ON PURPOSE: if a motor
    // command ever hangs, heartbeats stop too, and the SPARK MAX controllers
    // disable themselves. See "Why the watchdog shares a thread" in the guide.
    safety_timer_ = create_wall_timer(
      HEARTBEAT_PERIOD, std::bind(&ControllerNode::safety_timer_callback, this));

    RCLCPP_INFO(get_logger(),
      "Ready. Robot is DISABLED until you hold %s. Mode: %s, %s",
      REQUIRE_BOTH_TRIGGERS ? "LT and RT" : "LT or RT",
      tank_mode_ ? "TANK" : "ARCADE", slow_mode_ ? "SLOW" : "FAST");
  }

  // Runs when the node is destroyed (for example after Ctrl+C)
  ~ControllerNode() override
  {
    stop_all();
  }

private:
  // ---------------- Hardware ----------------
  SparkMax leftMotor;
  SparkMax rightMotor;
  SparkMax leftLift;
  SparkMax rightLift;
  SparkMax tilt;
  SparkMax vibrator;

  rclcpp::Subscription<JoyMsg>::SharedPtr joy_sub_;
  rclcpp::TimerBase::SharedPtr safety_timer_;

  // ---------------- State ----------------
  bool enabled_         = false;  // true only while deadman held and not stopped
  bool stop_latched_    = false;  // set by B, the watchdog, or an error
  bool joy_lost_        = true;   // true until the first /joy message arrives
  bool slow_mode_       = START_IN_SLOW_MODE;
  bool tank_mode_       = START_IN_TANK_MODE;
  bool vibrator_active_ = false;
  SteadyClock::time_point last_joy_time_{};

  // Previous button states, used for edge detection (act once per press)
  bool prev_deadman_          = false;
  bool prev_stop_button_      = false;
  bool prev_speed_button_     = false;
  bool prev_drive_mode_button_ = false;
  bool prev_vibrator_button_  = false;
  std::array<bool, 4> prev_reserved_{};

  // Last commanded values, used for the status log
  double left_speed_  = 0.0;
  double right_speed_ = 0.0;
  int lift_dir_ = 0;  // +1 up, -1 down, 0 stopped
  int tilt_dir_ = 0;

  // =================================================================
  //  SETUP
  // =================================================================

  void configure_drive_motor(SparkMax &motor, bool inverted)
  {
    motor.SetIdleMode(IdleMode::kBrake);
    motor.SetMotorType(MotorType::kBrushless);
    motor.SetSensorType(SensorType::kHallSensor);
    motor.SetInverted(inverted);

    // Velocity PID (used by SetVelocity)
    motor.SetP(0, 0.0002f);
    motor.SetI(0, 0.0f);
    motor.SetD(0, 0.0f);
    motor.SetF(0, 0.00021f);

    // Smooth acceleration and current protection
    motor.SetClosedLoopRampRate(DRIVE_RAMP_RATE);
    motor.SetSmartCurrentStallLimit(DRIVE_CURRENT_LIMIT);
    motor.SetSmartCurrentFreeLimit(DRIVE_CURRENT_LIMIT);
  }

  void configure_actuator(SparkMax &motor, bool inverted)
  {
    motor.SetIdleMode(IdleMode::kBrake);
    motor.SetMotorType(MotorType::kBrushed);
    motor.SetSensorType(SensorType::kEncoder);
    motor.SetInverted(inverted);

    // Position PID. Not used by the D-pad (duty cycle), kept for a future
    // SetPosition() upgrade that moves the lift to preset heights.
    motor.SetP(0, 1.51f);
    motor.SetI(0, 0.0f);
    motor.SetD(0, 0.0f);
    motor.SetF(0, 0.00021f);

    // Smooth start/stop and current protection
    motor.SetRampRate(ACTUATOR_RAMP_RATE);
    motor.SetSmartCurrentStallLimit(ACTUATOR_CURRENT_LIMIT);
    motor.SetSmartCurrentFreeLimit(ACTUATOR_CURRENT_LIMIT);
  }

  void configure_motors()
  {
    configure_drive_motor(leftMotor, false);
    configure_drive_motor(rightMotor, true);   // right side is mirrored

    configure_actuator(leftLift, true);
    configure_actuator(rightLift, true);
    configure_actuator(tilt, true);

    vibrator.SetIdleMode(IdleMode::kBrake);
    vibrator.SetMotorType(MotorType::kBrushed);
    vibrator.SetSensorType(SensorType::kEncoder);
    vibrator.SetInverted(true);

    if (BURN_FLASH_ON_STARTUP) {
      leftMotor.BurnFlash();
      rightMotor.BurnFlash();
      leftLift.BurnFlash();
      rightLift.BurnFlash();
      tilt.BurnFlash();
      vibrator.BurnFlash();
    }
  }

  // =================================================================
  //  INPUT
  // =================================================================

  void joy_callback(const JoyMsg::SharedPtr msg)
  {
    last_joy_time_ = SteadyClock::now();

    // Crash protection: any error stops the motors instead of killing the node
    try {
      handle_input(*msg);
    } catch (const std::exception &e) {
      RCLCPP_ERROR(get_logger(), "Error handling controller input: %s. Stopping all motors.", e.what());
      stop_latched_ = true;
      enabled_ = false;
      stop_all();
    }
  }

  void handle_input(const JoyMsg &msg)
  {
    // ---- 1. Deadman (LT/RT) and STOP (B) ----
    const bool deadman      = deadman_held(msg);
    const bool deadman_edge = deadman && !prev_deadman_;  // just squeezed
    prev_deadman_ = deadman;

    const bool stop_button = button(msg, PAD.b);
    if (stop_button && !prev_stop_button_) {
      if (!stop_latched_) {
        RCLCPP_WARN(get_logger(),
          "STOP pressed: all motors stopped. Release and re-squeeze the trigger to resume.");
      }
      stop_latched_ = true;
    }
    prev_stop_button_ = stop_button;

    // A fresh squeeze of the deadman clears a STOP (but not while B is held)
    if (stop_latched_ && deadman_edge && !stop_button) {
      stop_latched_ = false;
      RCLCPP_INFO(get_logger(), "Stop cleared.");
    }

    // ---- 2. Mode toggles (work while disabled so you can pick before driving) ----
    const bool speed_button = button(msg, PAD.view);
    if (speed_button && !prev_speed_button_) {
      slow_mode_ = !slow_mode_;
      RCLCPP_INFO(get_logger(), "Speed: %s", slow_mode_ ? "SLOW" : "FAST");
    }
    prev_speed_button_ = speed_button;

    const bool drive_mode_button = button(msg, PAD.left_bumper);
    if (drive_mode_button && !prev_drive_mode_button_) {
      tank_mode_ = !tank_mode_;
      RCLCPP_INFO(get_logger(), "Drive mode: %s", tank_mode_ ? "TANK" : "ARCADE");
    }
    prev_drive_mode_button_ = drive_mode_button;

    report_reserved_buttons(msg);

    // ---- 3. Enable / disable ----
    const bool should_enable = deadman && !stop_latched_;
    if (!should_enable) {
      if (enabled_ && !stop_latched_) {
        RCLCPP_INFO(get_logger(), "Trigger released: robot DISABLED.");
      }
      enabled_ = false;
      stop_all();  // re-sent every message so a lost CAN frame can't leave a motor running
      prev_vibrator_button_ = button(msg, PAD.right_bumper);
      log_status();
      return;
    }

    if (!enabled_) {
      RCLCPP_INFO(get_logger(), "Trigger held: robot ENABLED (%s, %s).",
        tank_mode_ ? "TANK" : "ARCADE", slow_mode_ ? "SLOW" : "FAST");
      enabled_ = true;
      send_heartbeat();  // wake the controllers right away
    }

    // ---- 4. Drive ----
    double left_cmd = 0.0;
    double right_cmd = 0.0;
    if (tank_mode_) {
      left_cmd  = axis(msg, PAD.left_y);
      right_cmd = axis(msg, PAD.right_y);
    } else {
      // ARCADE: left stick up/down = drive, left/right = turn (left = +1.0)
      const double forward = axis(msg, PAD.left_y);
      const double turn    = axis(msg, PAD.left_x);
      left_cmd  = forward - turn;
      right_cmd = forward + turn;
      const double biggest = std::max(std::abs(left_cmd), std::abs(right_cmd));
      if (biggest > 1.0) {  // keep the turn shape when the stick is in a corner
        left_cmd  /= biggest;
        right_cmd /= biggest;
      }
    }

    const double scale = slow_mode_ ? SLOW_MODE_SCALE : 1.0;
    left_speed_  = std::clamp(left_cmd,  -1.0, 1.0) * VELOCITY_MAX * scale;
    right_speed_ = std::clamp(right_cmd, -1.0, 1.0) * VELOCITY_MAX * scale;

    leftMotor.SetVelocity(static_cast<float>(left_speed_));
    rightMotor.SetVelocity(static_cast<float>(right_speed_));

    // ---- 5. Lift (D-pad up/down) and tilt (D-pad left/right), move while held ----
    lift_dir_ = dpad_vertical(msg);
    tilt_dir_ = dpad_horizontal(msg);

    const float lift_output = static_cast<float>(lift_dir_) * LIFT_SPEED;
    leftLift.SetDutyCycle(lift_output);
    rightLift.SetDutyCycle(lift_output);   // both lifts move together
    tilt.SetDutyCycle(static_cast<float>(tilt_dir_) * TILT_SPEED);

    // ---- 6. Vibrator toggle (RB) ----
    const bool vib_button = button(msg, PAD.right_bumper);
    if (vib_button && !prev_vibrator_button_) {
      vibrator_active_ = !vibrator_active_;
      RCLCPP_INFO(get_logger(), "Vibrator %s", vibrator_active_ ? "ON" : "OFF");
    }
    prev_vibrator_button_ = vib_button;
    vibrator.SetDutyCycle(vibrator_active_ ? VIBRATOR_OUTPUT : 0.0f);

    log_status();
  }

  // A, X, Y and Menu are on the team layout but not built yet.
  // Pressing one prints a message so testers know it's expected.
  void report_reserved_buttons(const JoyMsg &msg)
  {
    const std::array<int, 4> index = {PAD.a, PAD.x, PAD.y, PAD.menu};
    const std::array<const char *, 4> name = {
      "A (Send Excavation Action)", "X (Reset Position)",
      "Y (Send Depositing Action)", "Menu (Start Navigation Cycle)"};

    for (std::size_t i = 0; i < index.size(); ++i) {
      const bool pressed = button(msg, index[i]);
      if (pressed && !prev_reserved_[i]) {
        RCLCPP_INFO(get_logger(), "%s is not implemented yet.", name[i]);
      }
      prev_reserved_[i] = pressed;
    }
  }

  // =================================================================
  //  SAFETY
  // =================================================================

  // Runs every HEARTBEAT_PERIOD: watchdog + heartbeat
  void safety_timer_callback()
  {
    const bool joy_fresh = (SteadyClock::now() - last_joy_time_) < JOY_TIMEOUT;

    if (!joy_fresh) {
      if (!joy_lost_) {
        joy_lost_ = true;
        RCLCPP_WARN(get_logger(),
          "No controller input for %lld ms: stopping all motors. "
          "Re-squeeze the trigger after it reconnects.",
          static_cast<long long>(std::chrono::milliseconds(JOY_TIMEOUT).count()));
        stop_latched_ = true;
        enabled_ = false;
        stop_all();
      }
      return;  // no heartbeat, so the controllers also disable themselves
    }

    if (joy_lost_) {
      joy_lost_ = false;
      RCLCPP_INFO(get_logger(), "Controller input received.");
    }

    // Heartbeats only while enabled: releasing the trigger lets the
    // SPARK MAX controllers time out and disable their outputs too.
    if (enabled_) {
      send_heartbeat();
    }
  }

  void send_heartbeat()
  {
    try {
      // One broadcast keeps every SPARK MAX on the bus enabled.
      // If your library version has a per-motor heartBeat() instead,
      // replace this line with leftMotor.heartBeat(); rightMotor.heartBeat(); ...
      SparkBase::Heartbeat();
    } catch (const std::exception &e) {
      RCLCPP_ERROR_THROTTLE(get_logger(), *get_clock(), 1000, "Heartbeat failed: %s", e.what());
    }
  }

  // Commands every motor to zero. Each command is tried separately so one
  // failure can't skip the others. Never throws.
  void stop_all()
  {
    auto attempt = [](auto &&command) {
      try { command(); } catch (...) {}
    };
    // Duty cycle 0 (not velocity 0) so the drive stops immediately
    // instead of following the drive ramp rate.
    attempt([this] { leftMotor.SetDutyCycle(0.0f); });
    attempt([this] { rightMotor.SetDutyCycle(0.0f); });
    attempt([this] { leftLift.SetDutyCycle(0.0f); });
    attempt([this] { rightLift.SetDutyCycle(0.0f); });
    attempt([this] { tilt.SetDutyCycle(0.0f); });
    attempt([this] { vibrator.SetDutyCycle(0.0f); });

    vibrator_active_ = false;  // vibrator will not restart by itself
    left_speed_ = right_speed_ = 0.0;
    lift_dir_ = tilt_dir_ = 0;
  }

  // =================================================================
  //  HELPERS
  // =================================================================

  // Safe reads: a missing button/axis reads as "not pressed" instead of crashing
  static bool button(const JoyMsg &msg, int index)
  {
    return index >= 0 && static_cast<std::size_t>(index) < msg.buttons.size() &&
           msg.buttons[static_cast<std::size_t>(index)] != 0;
  }

  static double axis(const JoyMsg &msg, int index)
  {
    if (index < 0 || static_cast<std::size_t>(index) >= msg.axes.size()) {
      return 0.0;
    }
    return msg.axes[static_cast<std::size_t>(index)];
  }

  static int direction_from_axis(double value)
  {
    if (value > 0.5)  return 1;
    if (value < -0.5) return -1;
    return 0;
  }

  static bool trigger_held(const JoyMsg &msg, int index)
  {
    if (PAD.triggers_are_axes) {
      // Some drivers report 0.0 until the trigger is first touched;
      // 0.0 is above the threshold, so that still reads as "not held".
      return axis(msg, index) < TRIGGER_PRESSED_BELOW;
    }
    return button(msg, index);
  }

  static bool deadman_held(const JoyMsg &msg)
  {
    const bool lt = trigger_held(msg, PAD.left_trigger);
    const bool rt = trigger_held(msg, PAD.right_trigger);
    return REQUIRE_BOTH_TRIGGERS ? (lt && rt) : (lt || rt);
  }

  // +1 = up, -1 = down, 0 = neither (or both)
  static int dpad_vertical(const JoyMsg &msg)
  {
    if (PAD.dpad_is_axes) {
      return direction_from_axis(axis(msg, PAD.dpad_y_axis));
    }
    const bool up = button(msg, PAD.dpad_up);
    const bool down = button(msg, PAD.dpad_down);
    return (up == down) ? 0 : (up ? 1 : -1);
  }

  // +1 = left (tilt up), -1 = right (tilt down), 0 = neither
  static int dpad_horizontal(const JoyMsg &msg)
  {
    if (PAD.dpad_is_axes) {
      return direction_from_axis(axis(msg, PAD.dpad_x_axis));
    }
    const bool left = button(msg, PAD.dpad_left);
    const bool right = button(msg, PAD.dpad_right);
    return (left == right) ? 0 : (left ? 1 : -1);
  }

  static const char *direction_name(int dir)
  {
    return dir > 0 ? "UP" : (dir < 0 ? "DOWN" : "-");
  }

  void log_status()
  {
    const char *state = stop_latched_ ? "STOPPED" : (enabled_ ? "ENABLED" : "DISABLED");
    RCLCPP_INFO_THROTTLE(get_logger(), *get_clock(), 1000,
      "%s | %s %s | L: %.0f RPM | R: %.0f RPM | Lift: %s | Tilt: %s | Vibrator: %s",
      state, tank_mode_ ? "TANK" : "ARCADE", slow_mode_ ? "SLOW" : "FAST",
      left_speed_, right_speed_,
      direction_name(lift_dir_), direction_name(tilt_dir_), vibrator_active_ ? "ON" : "OFF");
  }
};

// =====================================================================
//  MAIN
// =====================================================================

int main(int argc, char *argv[])
{
  rclcpp::init(argc, argv);
  const std::string can_interface = "can0";  // use "vcan0" for practice without the robot

  std::shared_ptr<ControllerNode> node;
  try {
    node = std::make_shared<ControllerNode>(can_interface);
  } catch (const std::exception &e) {
    RCLCPP_FATAL(rclcpp::get_logger("controller_node"),
      "Could not start (is %s up and wired?): %s", can_interface.c_str(), e.what());
    rclcpp::shutdown();
    return 1;
  }

  rclcpp::spin(node);
  node.reset();  // runs the destructor, which stops every motor
  rclcpp::shutdown();
  return 0;
}
